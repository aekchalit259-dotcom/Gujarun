-- Function 6: TimeStop (Client Side)
createToggleButton("6. หยุดเวลา (Client TimeStop)", 6, function(state)
    States.TimeStop = state
    if state then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                obj.Anchored = true
            end
        end
    else
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                obj.Anchored = false
            end
        end
    end
end)

